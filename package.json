{
  "name": "@catmeow/readme-ai",
  "version": "2.0.0",
  "description": "One command to generate an accurate, polished README.md from your codebase. Works with Gemini, Claude, OpenAI, Grok or a local Ollama model.",
  "bin": {
    "readme-ai": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && tsup --config tsup.server.config.ts",
    "build:server": "tsup --config tsup.server.config.ts",
    "dev": "tsx src/cli/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "node build/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:cli": "tsup && tsc -p tsconfig.build.json"
  },
  "keywords": [
    "readme",
    "readme-generator",
    "documentation",
    "ai",
    "cli",
    "gemini",
    "claude",
    "openai",
    "grok",
    "ollama"
  ],
  "author": "AtharvaShirke95032",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtharvaShirke95032/readme-ai-npm-package.git"
  },
  "homepage": "https://github.com/AtharvaShirke95032/readme-ai-npm-package#readme",
  "bugs": {
    "url": "https://github.com/AtharvaShirke95032/readme-ai-npm-package/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.5",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "hono": "^4.13.13",
    "ignore": "^7.0.12",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
