# Hosted server settings. Copy to .env for local development:  cp .env.example .env
# The CLI itself needs none of these.

# Required: key for the default (fast) model. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: enables Claude for `--quality high`. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: choose providers/models per tier (gemini | claude | openai | grok | ollama)
# FAST_PROVIDER=gemini
# FAST_MODEL=gemini-3.8-flash
# HIGH_PROVIDER=claude
# HIGH_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# XAI_API_KEY=
# OLLAMA_HOST=127.0.0.1:11434

# Optional: limits (per client IP) and a daily cap that protects your bill
# RATE_LIMIT=10
# RATE_WINDOW_MINUTES=15
# HIGH_RATE_LIMIT=3
# REPAIR_RATE_LIMIT=20
# DAILY_LIMIT=1000

# Optional: server
# PORT=3001
# TRUST_PROXY=true   # read the client IP from X-Forwarded-For (correct behind Render/Fly/Vercel)
